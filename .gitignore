# LEGO instruction PDFs are copyrighted ("own use only") and huge - never commit them.
*.pdf
# Some instruction files get dropped in here with no extension at all - catch those too.
/Star Destroyer
/[0-9]*-Super Yacht*

# Private client conversation - not part of the project deliverable.
разговор с закзчиками.rtf

# OS junk
.DS_Store
Thumbs.db

# Local Claude Code permission prefs (personal, not shared project config)
.claude/settings.local.json

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editor
.vscode/
.idea/

# Throwaway harnesses generated while debugging in a real browser.
/webapp/_selftest.html
/webapp/_preview_pages/

# Model training artefacts: the dataset rebuilds from the PDFs in a couple of
# minutes and the venv installs with one command, so neither belongs in git.
/tools/model/dataset*.npz
/tools/model/*.log
/tools/model/model_buckets*.png
/tools/model/model_prev_*.pt
/tools/model/model_candidate.pt

# Model work: re-derivable from the PDFs, or a picture to look at once.
/tools/model/.icons_*.pkl
/tools/model/.boxicons_*.pkl
/tools/model/studs*.png
/tools/model/*_sizes_*.png
/tools/model/*_silent.png
/tools/model/page*.png
/tools/model/row*.png
/tools/model/audit*_merges.png
/tools/model/audit*_dupes.png
/tools/model/*_metrics.json
/webapp/_run.html
/webapp/_shot.html
